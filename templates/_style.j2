<style>
  @font-face { font-family: 'Jacquard 24'; src: url(data:font/woff2;base64,{{ font_jacquard }}) format('woff2'); font-display: block; }
  @font-face { font-family: 'Press Start 2P'; src: url(data:font/woff2;base64,{{ font_press }}) format('woff2'); font-display: block; }
  @font-face { font-family: 'VT323'; src: url(data:font/woff2;base64,{{ font_vt323 }}) format('woff2'); font-display: block; }

  :root {
    --paper: #E9E4D6; --paper-deep: #DED8C4; --ink: #211E18; --ink-soft: #57503F;
    --accent: #BF3B2B; --rule: #211E18; --scanline: 0; --glow: none;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0B1006; --paper-deep: #121A0A; --ink: #9FE870; --ink-soft: #6BA34C;
      --accent: #FFB000; --rule: #46662F; --scanline: 0.05;
      --glow: 0 0 8px rgba(159, 232, 112, 0.35);
    }
  }
  :root[data-theme="light"] {
    --paper: #E9E4D6; --paper-deep: #DED8C4; --ink: #211E18; --ink-soft: #57503F;
    --accent: #BF3B2B; --rule: #211E18; --scanline: 0; --glow: none;
  }
  :root[data-theme="dark"] {
    --paper: #0B1006; --paper-deep: #121A0A; --ink: #9FE870; --ink-soft: #6BA34C;
    --accent: #FFB000; --rule: #46662F; --scanline: 0.05;
    --glow: 0 0 8px rgba(159, 232, 112, 0.35);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    background: var(--paper); color: var(--ink);
    font-family: 'VT323', 'Courier New', monospace;
    font-size: 20px; line-height: 1.35; margin: 0; padding: 24px 16px 64px;
  }

  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 0 28px; max-width: 1340px; margin: 0 auto; }
  .toc {
    position: sticky; top: 16px; align-self: start;
    max-height: calc(100vh - 32px); overflow-y: auto;
    border-right: 2px solid var(--rule); padding: 6px 14px 6px 0;
  }
  .toc-head {
    font-family: 'Press Start 2P', monospace; font-size: 9px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-soft);
    border-bottom: 6px double var(--rule); padding-bottom: 8px; margin: 0 0 8px;
  }
  .toc a {
    display: block; text-decoration: none; font-size: 17px; line-height: 1.3;
    padding: 6px 8px; border-left: 4px solid transparent; color: var(--ink);
  }
  .toc a:hover { color: var(--accent); }
  .toc a.active { border-left-color: var(--accent); color: var(--accent); background: var(--paper-deep); }
  .toc a.toc-lead { font-size: 18px; }
  .toc a.toc-sec {
    font-family: 'Press Start 2P', monospace; font-size: 8px; letter-spacing: 1px;
    text-transform: uppercase; margin-top: 6px; padding-top: 10px;
    border-top: 1px dashed var(--rule);
  }

  canvas.banner {
    display: block; width: 100%; height: auto;
    image-rendering: pixelated; margin: 0 0 14px;
  }
  section.story { padding-top: 26px; }
  section.story:first-of-type { padding-top: 10px; }
  .headline-xl {
    font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: clamp(22px, 3.4vw, 34px); line-height: 1.35; margin: 0 0 8px; text-wrap: balance;
  }
  .headline-lg {
    font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: clamp(16px, 2.4vw, 22px); line-height: 1.5; margin: 0 0 8px; text-wrap: balance;
  }
  .weatherline {
    text-align: center; border-bottom: 2px solid var(--rule);
    padding: 7px 10px; font-size: 18px;
  }
  .weatherline .lbl { text-transform: uppercase; letter-spacing: 1px; color: var(--ink-soft); }
  .weatherline b { font-family: 'Press Start 2P', monospace; font-size: 11px; font-weight: 400; color: var(--accent); }
  .paper-story { border-left: 4px solid var(--accent); padding-left: 14px; margin-bottom: 22px; }
  .paper-story h3 { font-size: 23px; font-weight: 400; margin: 0 0 2px; }
  .wire-title {
    font-family: 'Press Start 2P', monospace; font-weight: 400; font-size: 10px;
    letter-spacing: 2px; text-transform: uppercase;
    border-bottom: 2px solid var(--rule); padding-bottom: 6px; margin: 18px 0 6px;
    display: flex; justify-content: space-between; align-items: baseline;
  }
  body::after {
    content: ''; position: fixed; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgba(0,0,0,0.55) 0px, rgba(0,0,0,0.55) 1px, transparent 1px, transparent 3px);
    opacity: var(--scanline);
  }
  .sheet { max-width: 1060px; margin: 0 auto; }
  a { color: var(--ink); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  a:hover, a:focus-visible { color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .masthead { position: relative; text-align: center; border-bottom: 6px double var(--rule); padding-bottom: 10px; }
  .masthead h1 {
    font-family: 'Jacquard 24', serif; font-weight: 400;
    font-size: clamp(56px, 11vw, 118px); margin: 0; line-height: 1;
    letter-spacing: 1px; text-shadow: var(--glow); text-wrap: balance;
  }
  .masthead h1 a { text-decoration: none; color: inherit; }
  .masthead.small h1 { font-size: clamp(36px, 6vw, 60px); }
  .masthead .motto {
    font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-soft); margin: 10px 0 0;
  }
  .stamp {
    position: absolute; top: 4px; right: 0; transform: rotate(6deg);
    font-family: 'Press Start 2P', monospace; font-size: 9px; line-height: 1.6;
    color: var(--accent); border: 3px solid var(--accent); padding: 8px 10px;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .dateline {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    border-bottom: 2px solid var(--rule); padding: 6px 2px;
    font-size: 17px; text-transform: uppercase; letter-spacing: 1px;
  }
  .pagenav {
    display: flex; flex-wrap: wrap; gap: 4px 18px; justify-content: center;
    border-bottom: 2px solid var(--rule); padding: 7px 2px;
    font-family: 'Press Start 2P', monospace; font-size: 8px;
    letter-spacing: 1px; text-transform: uppercase;
  }
  .pagenav a { text-decoration: none; }
  .pagenav .here { color: var(--accent); }
  .ticker {
    display: flex; flex-wrap: wrap; gap: 6px 22px; justify-content: center;
    background: var(--paper-deep); border-bottom: 2px solid var(--rule);
    padding: 8px 12px; font-size: 18px; font-variant-numeric: tabular-nums; text-transform: uppercase;
  }
  .ticker .lbl { color: var(--ink-soft); }

  .front { display: grid; grid-template-columns: 2fr 1fr; gap: 0; border-bottom: 2px solid var(--rule); }
  .lead { padding: 18px 22px 22px 2px; border-right: 2px solid var(--rule); }
  .sidebar { padding: 18px 2px 22px 22px; display: flex; flex-direction: column; gap: 22px; }

  .kicker {
    font-family: 'Press Start 2P', monospace; font-size: 9px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--accent); margin: 0 0 12px;
  }
  .lead h2 {
    font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: clamp(20px, 3.2vw, 30px); line-height: 1.35; margin: 0 0 6px; text-wrap: balance;
  }
  .lead h2 a { text-decoration: none; }
  .deck { font-size: 22px; color: var(--ink-soft); margin: 0 0 14px; }
  .byline { font-size: 16px; text-transform: uppercase; letter-spacing: 2px; color: var(--ink-soft); margin: 0 0 14px; }

  figure.art { margin: 0 0 16px; border: 3px solid var(--rule); }
  figure.art canvas { display: block; width: 100%; image-rendering: pixelated; }
  figure.art figcaption {
    font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--ink-soft);
    border-top: 3px solid var(--rule); padding: 5px 8px; background: var(--paper-deep);
  }

  .cols-2 { column-count: 2; column-gap: 26px; column-rule: 1px solid var(--rule); }
  .cols-2 p { margin: 0 0 12px; }
  .cols-2 p:first-of-type::first-letter, .article-body p:first-of-type::first-letter {
    font-family: 'Jacquard 24', serif; font-size: 54px; line-height: 0.8;
    float: left; padding: 6px 8px 0 0;
  }
  .turn { font-size: 16px; text-transform: uppercase; letter-spacing: 1px; }

  .box { border: 3px solid var(--rule); }
  .box .box-title {
    font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; margin: 0; padding: 8px 10px;
    background: var(--ink); color: var(--paper);
  }
  .box .box-body { padding: 10px 12px; }
  .box ul { margin: 0; padding: 0; list-style: none; }
  .box li { padding: 7px 0; border-bottom: 1px dashed var(--rule); }
  .box li:last-child { border-bottom: none; }
  .box .src { font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--ink-soft); }
  .weather { text-align: center; padding: 10px 12px; }
  .weather .big { font-family: 'Press Start 2P', monospace; font-size: 13px; margin: 6px 0; }

  .section-label {
    font-family: 'Press Start 2P', monospace; font-size: 11px; letter-spacing: 3px;
    text-transform: uppercase; border-bottom: 6px double var(--rule);
    padding: 20px 0 8px; margin: 0 0 16px;
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
  }
  .section-label .page-no { color: var(--ink-soft); font-size: 9px; }

  .fullstory { padding: 4px 0 10px; border-bottom: 1px solid var(--rule); margin-bottom: 14px; }
  .fullstory:last-child { border-bottom: none; margin-bottom: 0; }
  .fullstory h3 {
    font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: 16px; line-height: 1.55; margin: 0 0 6px; text-wrap: balance;
  }
  .fullstory h3 a { text-decoration: none; }
  .briefs2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 30px; }
  .briefs2 .brief { border: none; border-bottom: 1px dashed var(--rule); padding: 10px 0 12px; }

  .briefs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .brief { padding: 0 20px 16px; border-right: 1px solid var(--rule); }
  .brief:nth-child(3n+1) { padding-left: 2px; }
  .brief:nth-child(3n) { border-right: none; padding-right: 2px; }
  .brief:nth-child(n+4) { border-top: 1px solid var(--rule); padding-top: 14px; }
  .brief h3 {
    font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: 13px; line-height: 1.5; margin: 0 0 8px; text-wrap: balance;
  }
  .brief h3 a { text-decoration: none; }
  .brief .src { font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--ink-soft); }

  .papers-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 26px; }
  .paper { border-left: 4px solid var(--accent); padding-left: 12px; }
  .paper h3 { font-size: 22px; font-weight: 400; margin: 0 0 4px; }
  .paper .meta { font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--ink-soft); }
  .paper .abstract { font-size: 18px; color: var(--ink-soft); margin: 4px 0 0; }

  .classifieds {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
    background: var(--paper-deep); border: 3px solid var(--rule); padding: 12px; font-size: 17px;
  }
  .classifieds .ad { border: 1px dashed var(--rule); padding: 8px 10px; }
  .classifieds .ad b {
    display: block; font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: 8px; letter-spacing: 1px; margin-bottom: 6px; text-transform: uppercase;
  }
  .colophon {
    text-align: center; font-size: 16px; text-transform: uppercase;
    letter-spacing: 2px; color: var(--ink-soft); margin-top: 28px;
  }
  .colophon .cursor {
    display: inline-block; width: 10px; height: 18px; background: var(--accent);
    vertical-align: text-bottom; animation: blink 1.1s steps(1) infinite;
  }
  @media (prefers-reduced-motion: reduce) { .colophon .cursor { animation: none; } }
  @keyframes blink { 50% { opacity: 0; } }

  /* article pages */
  .article-wrap { max-width: 760px; margin: 0 auto; padding-top: 20px; }
  .article-wrap h2 {
    font-family: 'Press Start 2P', monospace; font-weight: 400;
    font-size: clamp(20px, 3.4vw, 32px); line-height: 1.4; margin: 0 0 10px; text-wrap: balance;
  }
  .article-body { margin-top: 16px; }
  .article-body p { margin: 0 0 14px; }
  .source-box { margin-top: 24px; }

  /* wire page */
  .wire-group { margin-bottom: 8px; }
  .wire-list { margin: 0 0 18px; padding: 0; list-style: none; }
  .wire-list li { padding: 6px 0; border-bottom: 1px dashed var(--rule); display: flex; gap: 12px; align-items: baseline; }
  .wire-list .when { color: var(--ink-soft); font-size: 15px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .wire-list .snip { color: var(--ink-soft); font-size: 17px; }

  @media (max-width: 900px) {
    body { font-size: 19px; padding: 16px 10px 48px; }
    .layout { grid-template-columns: 1fr; }
    .toc { display: none; }
    .stamp { position: static; display: inline-block; margin-top: 10px; transform: rotate(-3deg); }
    .front, .briefs, .briefs2 { grid-template-columns: 1fr; }
    .cols-2 { column-count: 1; }
    .brief { border-right: none; border-bottom: 1px solid var(--rule); padding: 12px 2px; }
    .papers-grid { grid-template-columns: 1fr; }
    .classifieds { grid-template-columns: 1fr; }
    .wire-list li { flex-direction: column; gap: 2px; }
  }
</style>
