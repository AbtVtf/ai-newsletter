      "name": "arXiv cs.AI + cs.LG + cs.CL",
      "url": "https://rss.arxiv.org/rss/cs.AI+cs.LG+cs.CL",
      "type": "rss",
      "cadence": "daily at midnight ET, empty Sat/Sun and arXiv holidays",
      "status": "verified",
      "notes": "Official feed, categories combined with '+', capped at 2000 items."
    },
